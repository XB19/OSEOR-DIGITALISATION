# =====================================================================
# Modèle de configuration — copier en `.env` et renseigner les valeurs.
# NE JAMAIS committer le fichier `.env` réel (secrets).
# =====================================================================

# --- Général ---
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-moi-en-prod
DEBUG=True
# En prod : liste des domaines, ex. oseor.example.com,api.oseor.example.com
ALLOWED_HOSTS=*

# --- Base de données PostgreSQL ---
# Dev : pooler Supabase (IPv4). Prod : serveur co-localisé avec l'app.
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
# Connexions persistantes (efficace en WSGI). 0 = reconnexion à chaque requête.
DB_CONN_MAX_AGE=600

# --- CORS (origines du frontend autorisées) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Redis (channel layer WebSocket) ---
# Indispensable dès que l'API (WSGI) et le WebSocket (daphne) sont 2 processus.
REDIS_URL=redis://127.0.0.1:6379/0

# --- E-mail ---
# Dev : console (affiche les mails dans le terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@oseor-digitalisation.local
# Prod (Office 365) : décommenter et utiliser le backend SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=service@oseor.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Sécurité prod (uniquement si DEBUG=False) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
